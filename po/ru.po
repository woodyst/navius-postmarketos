msgstr "  ·  %1 км/ч"

#: qml/Main.qml:1152 qml/Main.qml:1162 qml/Main.qml:1191
msgid ", límite %1 kilómetros por hora"
msgstr ", ограничение %1 километров в час"

#: qml/Main.qml:1158
