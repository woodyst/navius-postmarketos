msgid "Track sin puntos suficientes"
msgstr "Trackak ez ditu nahiko puntu"

#: qml/Main.qml:865 qml/Main.qml:8882 qml/Main.qml:9719
msgid "OSM Scout · rutas y mapas offline"
msgstr "OSM Scout · lineaz kanpoko ibilbideak eta mapak"

