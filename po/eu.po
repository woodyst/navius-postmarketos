msgstr "Zerbitzaria: "

#: qml/Main.qml:1100
msgid "⚠ No se pudieron obtener los radares · revisa la conexión"
msgstr "⚠ Ezin izan dira radarrak lortu · egiaztatu konexioa"

#: qml/Main.qml:1480
msgid "Radar de tramo  ·  %1 m restantes"
msgstr "Tarteko radarra  ·  %1 m falta"

#: qml/Main.qml:1481
msgid "Radar de tramo, %1 metros"
msgstr "Tarteko radarra, %1 metro"

#: qml/Main.qml:1483 qml/Main.qml:1493 qml/Main.qml:1522
