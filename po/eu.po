#: qml/WhatsNewDialog.qml:25
msgid ""
"Búsqueda de puntos de interés cerca de ti: gasolineras, parking, "
"restaurantes, hoteles y más"
msgstr ""
"Inguruko interesguneak bilatu: gasolindegia, aparkalekua, jatetxea, hotela "
"eta gehiago"

#: qml/WhatsNewDialog.qml:26
msgid ""
"Detección automática de rutas más rápidas por tráfico durante la navegación"
msgstr "Trafikoagatik ibilbide azkarragoak detektatzea nabigazioan"

#: qml/WhatsNewDialog.qml:27
msgid "Opción para limpiar caché de Google Maps en el menú de Ajustes"
msgstr "Google Maps cachea garbitzeko aukera Ezarpenak menuan"

#: qml/WhatsNewDialog.qml:28
msgid ""
"Pantalla de novedades al iniciar con opción para desactivarla en Ajustes"
msgstr "Hasierako berrien pantaila, Ezarpenetan desgaitzeko aukerarekin"

#: qml/WhatsNewDialog.qml:92
msgid "Novedades"
msgstr "Berriak"

#: qml/WhatsNewDialog.qml:153
