msgid "Confirmar contraseña"
msgstr "Pasahitza berretsi"

#: qml/LoginPanel.qml:399
msgid "Recordar sesión"
msgstr "Gogoan hartu"

#: qml/LoginPanel.qml:427
msgid "Reenviar email de verificación"
msgstr "Egiaztapen e-maila berriro bidali"

#: qml/LoginPanel.qml:438
msgid "Email enviado. Revisa tu bandeja de entrada."
msgstr "Mezua bidali da. Begiratu sarrera-ontzia."

#: qml/LoginPanel.qml:439
msgid "No se pudo enviar. Inténtalo más tarde."
msgstr "Ezin izan da bidali. Saiatu geroago."

#: qml/LoginPanel.qml:467
msgid ""
"Acepto que mi ubicación se use para mostrar anuncios cercanos, alertas "
"comunitarias y estadísticas de uso mientras tengo sesión iniciada."
msgstr ""
"Saioa hasita nagoen bitartean nire kokapena inguruko iragarkiak, "
"komunitatearen alertak eta erabilera-estatistikak bistaratzeko erabiltzea "
"onartzen dut."

#: qml/LoginPanel.qml:512
msgid "Escribe tu contraseña"
msgstr "Idatzi zure pasahitza"

#: qml/LoginPanel.qml:542
msgid "Rellena todos los campos"
msgstr "Bete eremu guztiak"

#: qml/LoginPanel.qml:549
msgid "Las contraseñas no coinciden"
msgstr "Pasahitzak ez dira berdinak"

#: qml/LoginPanel.qml:563
msgid "Cuenta creada. Revisa tu email para verificarla."
msgstr "Kontua sortu da. Begiratu zure posta egiaztatzeko."

