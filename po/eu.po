msgstr "  ·  %1 km/h"

#: qml/Main.qml:1484 qml/Main.qml:1494 qml/Main.qml:1523 qml/Main.qml:1641
msgid ", límite %1 kilómetros por hora"
msgstr ", muga %1 kilometro orduko"

#: qml/Main.qml:1490
msgid "Radar de tramo  ·  a %1 m"
msgstr "Tarteko radarra  ·  %1 m-ra"

#: qml/Main.qml:1491
