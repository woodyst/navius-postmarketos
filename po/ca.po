#: qml/WhatsNewDialog.qml:22
msgid ""
"Búsqueda de puntos de interés cerca de ti: gasolineras, parking, "
"restaurantes, hoteles y más"
msgstr ""
"Cerca de punts d'interès prop vostre: gasolineres, aparcaments, restaurants, "
"hotels i més"

#: qml/WhatsNewDialog.qml:23
msgid ""
"Detección automática de rutas más rápidas por tráfico durante la navegación"
msgstr ""
"Detecció automàtica de rutes més ràpides per trànsit durant la navegació"

#: qml/WhatsNewDialog.qml:24
msgid "Opción para limpiar caché de Google Maps en el menú de Ajustes"
msgstr "Opció per esborrar la memòria cau de Google Maps al menú d'Ajustos"

#: qml/WhatsNewDialog.qml:25
msgid ""
"Pantalla de novedades al iniciar con opción para desactivarla en Ajustes"
msgstr "Pantalla de novetats a l'inici amb opció per desactivar-la als Ajustos"

#: qml/WhatsNewDialog.qml:89
msgid "Novedades"
msgstr "Novetats"

#: qml/WhatsNewDialog.qml:150
